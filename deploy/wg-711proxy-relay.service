[Unit]
Description=WireGuard-only relay to the shared 711Proxy rotating endpoint
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
Environment=WG_MGMT_BIND=10.66.67.1
Environment=WG_MGMT_TARGET_HOST=us.rotgb.711proxy.com
Environment=WG_MGMT_PORTS=19110:10000
ExecStart=/usr/bin/python3 /opt/wg-mgmt-proxy/wg_mgmt_proxy.py
Restart=always
RestartSec=2
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/wg-mgmt-proxy

[Install]
WantedBy=multi-user.target
